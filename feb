FOXGLOVE_URL = f"foxglove://open?ds=foxglove-websocket&ds.url=ws://localhost:{FOXGLOVE_PORT}"


def foxglove_app():
    """The Foxglove desktop app, if installed; the name changed from Foxglove Studio to Foxglove in 2024."""
    system = platform.system()
    if system == "Darwin":
        candidates = [pathlib.Path("/Applications") / n for n in ("Foxglove.app", "Foxglove Studio.app")]
    elif system == "Windows":
        base = pathlib.Path(os.environ.get("LOCALAPPDATA", "")) / "Programs"
        pf = pathlib.Path(os.environ.get("ProgramFiles", r"C:\Program Files"))
        candidates = [base / "Foxglove" / "Foxglove.exe", base / "Foxglove Studio" / "Foxglove Studio.exe",
                      pf / "Foxglove" / "Foxglove.exe", pf / "Foxglove Studio" / "Foxglove Studio.exe"]
    else:
        candidates = [pathlib.Path(p) for p in (shutil.which("foxglove"), shutil.which("foxglove-studio")) if p]
        candidates += [pathlib.Path(os.environ.get("FEB_FOXGLOVE_APP", "/nonexistent"))]
    return next((c for c in candidates if c.exists()), None)


def open_foxglove():
    """Open Foxglove on the running devkit (every topic, live). Prints the connection details if the
    app is not installed, so the member can connect by hand or use the web app."""
    app = foxglove_app()
    hint = f"Foxglove: Open connection -> Foxglove WebSocket -> ws://localhost:{FOXGLOVE_PORT}"
    if app is None:
        print(f"{hint}  (desktop app not found; install from https://foxglove.dev/download)")
        return
    system = platform.system()
    if system == "Darwin":
        cmd = ["open", "-a", str(app), FOXGLOVE_URL]
    else:
        cmd = [str(app), FOXGLOVE_URL]
    subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    print(f"opened {app.name} on ws://localhost:{FOXGLOVE_PORT}")


