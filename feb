def default_ws():
    """Where drivers are built from: the team repo on the car (it holds every merged driver),
    your own stack/ on a laptop. --ws overrides either."""
    return TEAM_STACK if ON_CAR and TEAM_STACK.is_dir() else STACK
RELEASES_API = "https://api.github.com/repos/FEBAutonomous/feb-racing/releases/latest"


def fail(msg):
    sys.exit(f"feb: {msg}")


def docker(*args, **kw):
    kw.setdefault("capture_output", True)
    kw.setdefault("text", True)
    return subprocess.run(["docker", *args], **kw)


# ------------------------------------------------------------------ simulator app

def app_executable():
    return sim.executable()



def cmd_setup(args):
    if args.team:
        CONFIG.parent.mkdir(parents=True, exist_ok=True)
        CONFIG.write_text(json.dumps({"team": args.team}))
        print(f"results will be listed as '{args.team}'")
    if not shutil.which("docker"):
        fail("Docker is not installed. Install Docker Desktop (Mac/Windows) or docker.io (Linux) first.")
    subprocess.run(["docker", "pull", GUI_IMAGE], check=True)
    ensure_app()
    check_foxglove()
    ensure_box()
    write_attach_config()
    print(f"\nready. `./feb shell` for a terminal in the box, `./feb code` for VS Code in it, `./feb up` to race.")


def cmd_update(_):
    """Bring everything up to date: the repo (tracks, launcher, docs), the images, the app. A new
    image means a new box (your installs go, your files stay)."""
    if (ROOT / ".git").exists():
        subprocess.run(["git", "-C", str(ROOT), "pull", "--ff-only"], check=False)
    before = image_id(GUI_IMAGE)
    subprocess.run(["docker", "pull", GUI_IMAGE], check=False)
    subprocess.run(["docker", "pull", IMAGE], check=False)
    if box_state() and image_id(GUI_IMAGE) != box_image_id():
        print("the image changed: replacing the box (anything you apt/pip installed in it is gone; your files are not)")
        docker("rm", "-f", BOX)
    latest = latest_release_stamp()
    if latest is None:
        print("could not reach GitHub to check the app; kept the installed one")
    elif latest == installed_release_stamp():
        print(f"simulator app is current ({latest})")
    else:
        install_app(latest)


STAMP = sim.APP_DIR / "release.json"      # which release asset the installed app came from


def installed_release_stamp():
    try:
        return json.loads(STAMP.read_text())["updated_at"]
    except (OSError, ValueError, KeyError):
        return None


def latest_release_stamp(timeout=4):
    """The updated_at of this platform's archive in the latest release, or None offline."""
    import urllib.request
    try:
        with urllib.request.urlopen(RELEASES_API, timeout=timeout) as r:
            release = json.load(r)
        return next(a["updated_at"] for a in release["assets"] if a["name"] == sim.archive_name())
    except Exception:
        return None


def install_app(stamp=None):
    import tarfile
    import urllib.request
    import zipfile
    name = sim.archive_name()
    dest = sim.platform_dir()
    if dest.is_symlink():
        dest.unlink()        # the organiser PC links the app to the build folder; do not write through it
    elif dest.exists():
        shutil.rmtree(dest)  # replace the old install wholesale: builds add and remove files
    dest.mkdir(parents=True)
    archive = sim.APP_DIR / name
    print(f"downloading {RELEASES}/{name} ...")
    urllib.request.urlretrieve(f"{RELEASES}/{name}", archive)
    if name.endswith(".zip"):
        if shutil.which("unzip"):    # keeps permissions and symlinks inside the Mac app bundle
            subprocess.run(["unzip", "-q", str(archive), "-d", str(dest)], check=True)
        else:
            zipfile.ZipFile(archive).extractall(dest)
    else:
        tarfile.open(archive).extractall(dest)
    archive.unlink()
    exe = app_executable()
    if exe is None:
        fail(f"unpacked the app but did not find the executable under {sim.APP_DIR}")
    exe.chmod(0o755)
    STAMP.write_text(json.dumps({"updated_at": stamp or latest_release_stamp() or ""}))
    print(f"simulator app installed: {exe}")


def ensure_app():
    """The simulator app for this OS, at the current release: installed if missing, replaced if it
    is from an older release (a release 1 leftover cannot talk to the practice runner)."""
    exe = app_executable()
    if exe and sim.platform_dir().is_symlink():
        print(f"simulator app linked to a build folder, kept: {exe}")      # the organiser PC
        return
    latest = latest_release_stamp()
    if exe and (latest is None or latest == installed_release_stamp()):
        print(f"simulator app present: {exe}")
        return
    if exe:
        print(f"simulator app is from an older release ({installed_release_stamp() or 'unknown'}): replacing it")
    install_app(latest)


def app_update_hint():
    """One line if a newer app is on the release page; silent offline (a 2 s budget)."""
    latest = latest_release_stamp(timeout=2)
    installed = installed_release_stamp()
    if latest and installed and latest != installed:
        print("a newer simulator app is available: ./feb update")


def check_foxglove():
    """Foxglove is how members look at their car's data (lidar, camera, plots). It is a separate
    desktop app with its own installer per OS and a one-time sign-in, so setup only points at it."""
    if foxglove_app():
        print(f"Foxglove app present: {foxglove_app()}")
        return
    print("Foxglove app not found. Install it from https://foxglove.dev/download and sign in once")
    print("(free account); `feb up` then opens it on your car's topics. Optional but recommended.")
    open_url("https://foxglove.dev/download")



# ------------------------------------------------------------------ the box

def box_state():
    """'running', 'stopped' or None."""
    out = docker("inspect", "--format", "{{.State.Running}}", BOX)
    if out.returncode != 0:
        return None
    return "running" if out.stdout.strip() == "true" else "stopped"


def box_image_id():
    return docker("inspect", "--format", "{{.Image}}", BOX).stdout.strip()


def image_id(image):
    return docker("image", "inspect", "--format", "{{.Id}}", image).stdout.strip()


def ensure_box():
    """The box: a persistent container from the gui image, your FEB folder mounted, the web
    desktop running, nothing else. Created once, started when stopped, reused forever."""
    state = box_state()
    if state == "running":
        return
    if state == "stopped":
        docker("start", BOX)
        return
    if FEB_DIR == pathlib.Path.home() or FEB_DIR == FEB_DIR.anchor:
        fail(f"this clone sits directly in {FEB_DIR}, and the box would mount all of it. Give it a folder of its own:\n"
             f"    mkdir ~/FEB && mv {ROOT} ~/FEB/   then run feb from there")
    if not image_id(GUI_IMAGE):
        print(f"pulling {GUI_IMAGE} (once; a few GB) ...")
        subprocess.run(["docker", "pull", GUI_IMAGE], check=True)
    print(f"creating the box ({BOX}) from {GUI_IMAGE}, your folder {FEB_DIR} mounted at {FEB_IN}")
    cmd = ["docker", "run", "-d", "--init", "--name", BOX, "--hostname", "feb-box", "--restart", "unless-stopped",   # --init reaps what the launches leave behind
           "--entrypoint", "/home/autodrive_devkit/box.sh",
           "-p", f"{PORT}:4567", "-p", f"{FOXGLOVE_PORT}:8765", "-p", f"{VNC_PORT}:6080",
           "-e", "ROS_LOCALHOST_ONLY=1", "-e", "DISPLAY=:1", "-e", "LIBGL_ALWAYS_SOFTWARE=1", "-e", "QT_X11_NO_MITSHM=1",
           "-e", f"FEB_WS={STACK_IN}", "-e", f"FEB_ROOT={ROOT_IN}",
           "-v", f"{FEB_DIR}:{FEB_IN}", "--user", "feb", "-w", ROOT_IN,
           "--label", "feb.box=1"]
    if ON_CAR:     # the VESC, the lidar and the gamepad: the whole of /dev, as the RoboRacer guide's container does
        cmd += ["--privileged", "-v", "/dev:/dev", "-e", "FEB_CAR=1"]
    cmd.append(GUI_IMAGE)
    if subprocess.run(cmd, stdout=subprocess.DEVNULL).returncode != 0:
        fail("docker run failed (see above)")
    if platform.system() == "Linux" and (os.getuid(), os.getgid()) != (1000, 1000):
        # the image's user is uid 1000; make it yours so files you create are yours
        docker("exec", "-u", "root", BOX, "bash", "-c",
               f"groupmod -g {os.getgid()} feb 2>/dev/null || groupmod -o -g {os.getgid()} feb; "
               f"usermod -o -u {os.getuid()} -g {os.getgid()} feb; chown -R feb:feb /home/feb")
    docker("exec", BOX, "mkdir", "-p", STACK_IN)


def in_box(path):
    """A laptop path under the FEB folder, as the box sees it."""
    p = pathlib.Path(path).resolve()
    try:
        return f"{FEB_IN}/{p.relative_to(FEB_DIR).as_posix()}"
    except ValueError:
        fail(f"{p} is outside your FEB folder ({FEB_DIR}); the box only sees that folder")


def exec_tty(*args, user="feb", workdir=None):
    """Run something in the box attached to this terminal."""
    tty = ["-it"] if sys.stdin.isatty() else ["-i"]
    cmd = ["docker", "exec", *tty, "-u", user] + (["-w", workdir] if workdir else []) + [BOX, *args]
    return subprocess.run(cmd).returncode


def bridge_up():
    """Is the bridge listening inside the box? (The published port answers even before it does.)"""
    out = docker("exec", BOX, "ss", "-ltn")
    return ":4567 " in out.stdout.replace("\n", " ")


def cmd_shell(args):
    ensure_box()
    if getattr(args, "gui", False):
        open_desktop()
    for name in (getattr(args, "apps", "") or "").replace(",", " ").split():
        docker("exec", "-d", "-u", "feb", BOX, "bash", "-ic", APPS.get(name, name))
    here = pathlib.Path.cwd()
    workdir = in_box(here) if FEB_DIR in here.parents or here == FEB_DIR else ROOT_IN
    if getattr(args, "command", None):
        sys.exit(exec_tty("bash", "-ic", args.command, workdir=workdir))
    print(f"box: {BOX}, your FEB folder at {FEB_IN}; ros2 and colcon work here; exit to leave, the box keeps running")
    sys.exit(exec_tty("bash", workdir=workdir))


def open_desktop():
    url = f"http://localhost:{VNC_PORT}/vnc.html?autoconnect=1&resize=scale"
    deadline = time.time() + 60
    while time.time() < deadline:
        with socket.socket() as s:
            s.settimeout(0.5)
            if s.connect_ex(("127.0.0.1", VNC_PORT)) == 0:
                break
        time.sleep(1)
    print(f"desktop: {url}")
    open_url(url)


def cmd_stop(_=None):
    docker("rm", "-f", OPPONENT, PROXY)
    if box_state() == "running":
        docker("exec", BOX, "feb-up", "--stop")
    print("stopped")


def cmd_reset(_):
    docker("rm", "-f", BOX, OPPONENT, PROXY)
    print(f"box removed; the next feb command makes a fresh one. Your files in {FEB_DIR} are untouched")


def cmd_logs(args):
    if box_state() != "running":
        fail("the box is not running; feb up or feb shell first")
    os.execvp("docker", ["docker", "exec", BOX, "tail", "-n", str(args.tail)] + (["-f"] if args.follow else []) + ["/tmp/feb-up.log"])


def cmd_code(args):
    """The editor attached to the box: VS Code (or Cursor with --cursor) opens ROOT inside it."""
    ensure_box()
    write_attach_config()
    editor = "cursor" if args.cursor else "code"
    exe = shutil.which(editor) or editor_binary(editor)
    if not exe:
        fail(f"{editor} is not on the PATH and the app was not found. In VS Code: Remote Explorer -> Dev Containers -> {BOX} -> Attach, folder {ROOT_IN}")
    uri = f"vscode-remote://attached-container+{BOX.encode().hex()}{ROOT_IN}"
    subprocess.Popen([exe, "--folder-uri", uri], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    print(f"asked {editor} to attach to {BOX} at {ROOT_IN}: its window should show 'Container {BOX}' bottom left; a dialog may ask first")


def editor_binary(editor):
    """The editor's own command-line binary when `code`/`cursor` is not on the PATH: a Mac only gets
    it after "Shell Command: Install 'code' command in PATH", Windows after a reinstall tick."""
    home = pathlib.Path.home()
    app = {"code": "Visual Studio Code", "cursor": "Cursor"}[editor]
    candidates = [pathlib.Path("/Applications") / f"{app}.app" / "Contents" / "Resources" / "app" / "bin" / editor,
                  home / "Applications" / f"{app}.app" / "Contents" / "Resources" / "app" / "bin" / editor,
                  pathlib.Path(os.environ.get("LOCALAPPDATA", "")) / "Programs" / ("Microsoft VS Code" if editor == "code" else "cursor") / "bin" / f"{editor}.cmd",
                  pathlib.Path("/usr/share/code/bin/code"), pathlib.Path("/snap/bin/code")]
    return next((str(c) for c in candidates if c.exists()), None)


def write_attach_config():
    """VS Code's per-container settings for attaching: the folder to open and the extensions."""
    system = platform.system()
    base = {"Darwin": pathlib.Path.home() / "Library" / "Application Support",
            "Windows": pathlib.Path(os.environ.get("APPDATA", pathlib.Path.home()))}.get(system, pathlib.Path.home() / ".config")
    cfg = {"workspaceFolder": ROOT_IN, "remoteUser": "feb", "extensions": ["ms-python.python", "ms-iot.vscode-ros"]}
    for app in ("Code", "Cursor"):
        d = base / app / "User" / "globalStorage" / "ms-vscode-remote.remote-containers" / "nameConfigs"
        if (base / app).exists():
            d.mkdir(parents=True, exist_ok=True)
            (d / f"{BOX}.json").write_text(json.dumps(cfg, indent=2))


# ------------------------------------------------------------------ up: house nodes + simulator + Foxglove

def resolve_track(name):
    """A track folder in ./tracks, an explicit folder, or a name the app knows."""
    for candidate in (pathlib.Path(name), TRACKS / name):
        if (candidate / "track.json").exists():
            return str(candidate.resolve())
    return name


def read_manifest(ws, name):
    """A driver package's driver.yaml: what it is for and how to start it in each mode.

        name: feb_driver
        kind: walls            # walls | cones | any
        modes:
          trackdrive: {launch: drive.launch.py, max_speed: 2.5}
          inspection: {launch: drive.launch.py, max_speed: 0.8}
        default_mode: trackdrive
    """
    for candidate in pathlib.Path(ws).rglob("driver.yaml"):
        m = load_yaml(candidate) or {}
        if m.get("name") == name:
            return m, candidate.parent
    fail(f"no driver.yaml with name '{name}' under {ws}")


def load_yaml(path):
    """Parse a yaml file with the laptop's PyYAML if it has one, else with the box's: a stock Mac
    or Windows Python has no PyYAML, and the launcher must not ask members to install anything."""
    try:
        import yaml
        return yaml.safe_load(pathlib.Path(path).read_text())
    except ImportError:
        ensure_box()
        out = subprocess.run(["docker", "exec", "-u", "feb", BOX, "python3", "-c",
                              "import sys, json, yaml; print(json.dumps(yaml.safe_load(open(sys.argv[1]))))", in_box(path)],
                             capture_output=True, text=True)
        if out.returncode != 0:
            fail(f"could not read {path}: {out.stderr.strip()}")
        return json.loads(out.stdout)


def driver_ws(args):
    """The workspace a --driver is built from: --ws if given, else the first of the default workspace
    and the starter kit that holds a card with that name. Sets args.ws so the build uses the same one."""
    if args.ws:
        return pathlib.Path(args.ws)
    for ws in (default_ws(), ROOT / "starter_kit"):
        if any(m.get("name") == args.driver for m in (load_yaml(c) or {} for c in ws.rglob("driver.yaml")) if m):
            args.ws = str(ws)
            return ws
    return default_ws()                     # read_manifest fails there with the clear message


def driver_command(args):
    """--driver NAME [--mode M] -> the stack command and the speed cap from its manifest."""
    ws = driver_ws(args)
    manifest, folder = read_manifest(ws, args.driver)
    modes = manifest.get("modes") or {}
    mode = args.mode_name or manifest.get("default_mode") or (next(iter(modes)) if modes else None)
    if mode not in modes:
        fail(f"driver {args.driver} has no mode '{mode}'; it has: {', '.join(modes) or 'none'}")
    m = modes[mode]
    launch = m.get("launch", "drive.launch.py")
    extra = " ".join(f"{k}:={v}" for k, v in (m.get("args") or {}).items())
    stack = f"ros2 launch {args.driver} {launch} mode:={mode} {extra}".strip()
    print(f"driver {args.driver} ({manifest.get('kind', 'any')}), mode {mode}: {stack}")
    args.adapter = ",".join(f"{k}={v}" for k, v in (manifest.get("adapter") or {}).items())   # sim adapter settings the driver asks for
    return stack, m.get("max_speed")


def cmd_up(args):
    if args.car:
        args.no_sim = True          # the car is the simulator's replacement, not its companion
    if args.deadman and not args.car and not sys.stdin.isatty():
        fail("--deadman turns this terminal into the gamepad, so it needs a real terminal (not a pipe or a script)")
    if args.driver:
        args.stack, cap = driver_command(args)
        if args.max_speed is None and cap is not None:
            args.max_speed = float(cap)
    exe = app_executable()
    if exe is None and not args.no_sim:
        fail("simulator app not found; run `feb setup` or set FEB_SIM_APP")
    ensure_box()
    if not args.no_sim:
        app_update_hint()
    ws = in_box(args.ws) if args.ws else in_box(default_ws())
    track = resolve_track(args.track)
    up = ["docker", "exec", "-u", "feb", BOX, "feb-up", "--ws", ws]
    if args.stack:
        up += ["--stack", args.stack]
    if args.noise:
        up += ["--noise", args.noise]
    if getattr(args, "adapter", ""):
        up += ["--adapter", args.adapter]
    if args.no_foxglove:
        up += ["--no-foxglove"]
    if args.car:
        up += ["--car"]
    if args.deadman and not args.car:
        up += ["--deadman", "--quiet"]       # the terminal becomes the gamepad; output goes to feb logs
    if args.max_speed is not None:
        up += ["--max-speed", str(args.max_speed)]
    print(f"starting the house nodes in {BOX} (workspace {ws}) ...")
    house = subprocess.Popen(up)
    sim_proc = None
    try:
        if not args.no_sim and not args.car:
            deadline = time.time() + 900                 # a first C++ build on a slow laptop takes that long
            while time.time() < deadline and house.poll() is None and not bridge_up():
                time.sleep(1)
            if house.poll() is not None:
                fail("the house nodes stopped before the bridge opened; see above or `feb logs`")
            if not bridge_up():
                fail("the bridge did not open port %d within 15 min (`feb logs`)" % PORT)
            sim_proc = start_sim(exe, args, track)
            if not args.headless and not args.no_foxglove:
                time.sleep(4)          # let the window come up first, so Foxglove lands on top
                open_foxglove()
        elif not args.no_foxglove and not args.headless:
            open_foxglove()
        if args.deadman and not args.car and house.poll() is None:
            print("the car's rules: nothing drives until a dead-man is held. This terminal is the gamepad; `feb logs -f` elsewhere shows the nodes.")
            time.sleep(2)
            exec_tty("bash", "-ic", "ros2 run feb_tools key_joy")      # returns on Q
        else:
            while house.poll() is None and (sim_proc is None or sim_proc.poll() is None):
                time.sleep(0.5)
    except KeyboardInterrupt:
        pass
    finally:
        if sim_proc and sim_proc.poll() is None:
            sim_proc.terminate()
        docker("exec", BOX, "feb-up", "--stop")
        docker("rm", "-f", OPPONENT, PROXY)
        try:
            house.wait(15)
        except subprocess.TimeoutExpired:
            house.kill()


def start_sim(exe, args, track):
    mode = args.mode or ("autonomous" if args.stack else "manual")
    cars, port = args.cars, PORT
    if args.opponent:
        if not args.stack:
            fail("--opponent races your stack, so it needs --stack \"ros2 launch ...\" as well")
        if not pathlib.Path(track).is_dir():
            fail("--opponent needs a track folder with track.json (a name from ./tracks or a path)")
        if json.loads((pathlib.Path(track) / "track.json").read_text()).get("max_cars", 4) < 2:
            fail(f"{pathlib.Path(track).name} is a single-car track (too narrow to race side by side)")
        start_opponent(args.opponent, track)
        cars, port = max(cars, 2), PROXY_PORT
    cmd = [str(exe), "--track", track, "--tracks", str(TRACKS), "--connect", f"127.0.0.1:{port}",
           "--mode", mode, "--cars", str(cars)]
    if args.lidar_hz:
        cmd += ["--lidar-hz", str(args.lidar_hz)]
    if args.camera:
        cmd += ["--camera", args.camera]
    if args.look or args.headless:
        cmd += ["--look", "simple" if args.headless else args.look]   # nothing to see headless
    if args.fps is not None:
        cmd += ["--fps", str(args.fps)]
    if args.camera_hz is not None:
        cmd += ["--camera-hz", str(args.camera_hz)]
    if args.headless:
        cmd += ["-batchmode", "-nographics"]
    print("starting simulator:", " ".join(cmd[1:]))
    return subprocess.Popen(cmd)


def start_opponent(level, track):
    """The house racer in its own container, plus the proxy that feeds car 2 to it. Default: the
    smooth lidar driver from the starter kit at a conservative pace (the thing to overtake);
    "map" runs the map-following driver instead."""
    subprocess.run(["docker", "rm", "-f", OPPONENT, PROXY], capture_output=True)
    if not json.loads((pathlib.Path(track) / "track.json").read_text()).get("walls"):
        level = "map"   # no walls to follow: the lidar racer would wander; the map follower knows the lane
    if level == "map":
        launch = f"ros2 run feb_tools house_driver --ros-args -p track:=/track -p max_speed:={MAP_OPPONENT_SPEED} -p use_sim_time:=true"
        speed = MAP_OPPONENT_SPEED
    else:
        speed = OPPONENT_SPEED[level]
        launch = f"ros2 run feb_driver reactive_driver --ros-args -p max_speed:={speed} -p bubble:=0.45 -p follow_gap:=2.0 -p use_sim_time:=true"
    subprocess.run(["docker", "run", "-d", "--rm", "--name", OPPONENT, "-p", f"{OPPONENT_PORT}:4567", "-e", "ROS_LOCALHOST_ONLY=1",
                    "-e", "FEB_FOXGLOVE=0",
                    "-v", f"{track}:/track:ro", "-v", f"{ROOT / 'starter_kit'}:/home/autodrive_devkit/src/stack:ro",
                    "-e", f"FEB_LAUNCH={launch}", IMAGE], check=True, stdout=subprocess.DEVNULL)
    proxy = ROOT / "febrace" / "proxy.py"
    subprocess.run(["docker", "run", "-d", "--rm", "--name", PROXY, "-p", f"{PROXY_PORT}:{PROXY_PORT}",
                    "--add-host", "host.docker.internal:host-gateway",         # no host networking: Docker Desktop keeps it in its VM
                    "-v", f"{proxy}:/tmp/proxy.py:ro",
                    "--entrypoint", "python3", IMAGE, "-u", "/tmp/proxy.py", "--verbose", "--port", str(PROXY_PORT),
                    "--devkits", str(PORT), str(OPPONENT_PORT), "--rate", "10", "--host", "host.docker.internal"], check=True, stdout=subprocess.DEVNULL)
    print(f"opponent: {'map-following' if level == 'map' else 'lidar'} house racer at {speed} m/s")


