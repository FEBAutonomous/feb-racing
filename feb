def team_name():
    try:
        return json.loads(CONFIG.read_text())["team"]
    except (OSError, KeyError, ValueError):
        fail("no name yet; run `feb setup --name \"Your Name\"` (as listed in submissions.yaml)")


def practice_set(kind):
    """The practice tracks a driver of this kind is scored on: every qualifying track with walls
    for a walls driver, with cones for a cones driver, both for 'any' or 'all'."""
    out = []
    for folder in sorted(TRACKS.glob("*/track.json")):
        t = json.loads(folder.read_text())
        if not t.get("qualifying", True):
            continue
        has = "cones" if t.get("cones") else "walls"
        if kind in ("any", "all") or kind == has:
            out.append(folder.parent)
    return out


def cmd_practice(args):
    """Scored attempts under competition rules, on your own machine: one track with --track, or
    the driver's whole practice set (its kind's qualifying tracks) without it."""
    from febrace import rules
    from febrace.runner import Attempt
    kind = "all"
    if args.driver:
        args.stack, _ = driver_command(args)
        kind = read_manifest(driver_ws(args), args.driver)[0].get("kind", "any")
    exe = app_executable()
    if exe is None:
        fail("simulator app not found; run `feb setup` or set FEB_SIM_APP")
    if not args.stack:
        fail("practice needs your stack: --driver NAME, or --stack \"ros2 launch feb_driver drive.launch.py\"")
    if args.track and args.track != "all":
        tracks = [pathlib.Path(resolve_track(args.track))]
    else:
        tracks = practice_set("all" if args.track == "all" else kind)
        print(f"practice set for a {kind} driver: {', '.join(t.name for t in tracks)}  (about {4 * len(tracks)} min)")
    docker("rm", "-f", OPPONENT, PROXY)        # practice has its own container and port; a running feb up is left alone
    done = []
    for track in tracks:
        attempt = Attempt(image=IMAGE, track=track, sim_exe=exe, team=team_name(),
                          rules=rules.Rules(laps=args.laps), port=PORT + 100, headless=args.headless,   # the box holds PORT
                          stack_dir=pathlib.Path(args.ws).resolve() if args.ws else default_ws(), stack_cmd=args.stack, runs_dir=ROOT / "runs",
                          adapter=getattr(args, "adapter", ""))
        result = attempt.run()
        if args.driver:        # what feb submit needs to push the code: the driver and where it lives
            (attempt.dir / "driver.json").write_text(json.dumps({"driver": args.driver, "ws": str(pathlib.Path(args.ws).resolve() if args.ws else default_ws())}))
        done.append((track.name, result, attempt.dir))
        print(f"\n{track.name}: {result['status']}, laps {result['laps_completed']}, collisions {result['collisions']}, "
              f"total {result['total_s']} s, best lap {result['best_lap_s']} s   ({attempt.dir.name})")
    if len(done) > 1:
        print("\n%-20s %-9s %5s %5s %9s" % ("track", "status", "laps", "hits", "total s"))
        for name, r, _ in done:
            print("%-20s %-9s %5s %5s %9s" % (name, r["status"], r["laps_completed"], r["collisions"], r["total_s"] or "-"))
    clean = [d for _, r, d in done if r["status"] == "finished" and r["collisions"] == 0]
    if clean:
        print(f"\n{len(clean)} of {len(done)} clean (finished, no collisions). Post them with: ./feb submit")
    else:
        print(f"\nnone of {len(done)} clean (finished, no collisions): nothing to post. `feb logs`, or the run folder's sim.log and container.log, say why")
        sys.exit(1)


def unsubmitted_runs(team, include_all=False):
    """Run folders not yet posted: this team's, finished with at most the qualifying number of
    collisions unless include_all, oldest first."""
    from febrace.rules import QUALIFY_MAX_COLLISIONS
    runs = []
    for res in sorted((ROOT / "runs").glob("*/result.json"), key=os.path.getmtime):
        r = json.loads(res.read_text())
        if (res.parent / ".submitted").exists() or r.get("team") != team or r.get("event") != "practice":
            continue
        if include_all or (r["status"] == "finished" and r["collisions"] <= QUALIFY_MAX_COLLISIONS):
            runs.append((res.parent, r))
    return runs


def cmd_submit(args):
    """Post practice results to the scoreboard and the driver's code to the team repo, each as
    one pull request (needs the gh CLI): every clean run not yet posted, or the one named."""
    from febrace import results
    if args.run:
        d = pathlib.Path(args.run)
        runs = [(d, json.loads((d / "result.json").read_text()))]
    else:
        runs = unsubmitted_runs(team_name(), args.all)
    if not runs:
        fail("nothing to post: no clean finished practice run (no collisions) that has not been posted; --all posts the rest, --run picks one")
    for d, r in runs:
        print(f"{r['track']:20s} {r['status']:9s} total {r['total_s']} s  ({d.name})")
    drivers = {}
    for d, _ in runs:
        if (d / "driver.json").exists():
            info = json.loads((d / "driver.json").read_text())
            drivers.setdefault((info["driver"], info["ws"]), []).append(d)
    if args.code and not drivers:
        print("no driver recorded for these runs (practice without --driver): results only")
    if args.dry_run:
        for (name, ws), ds in drivers.items():
            manifest, _ = read_manifest(pathlib.Path(ws), name)
            print(f"code: {name} from {ws}: packages {', '.join(manifest.get('packages') or [name])} -> {STACK_REPO} drivers/{slug(team_name())}/")
        print("dry run: nothing posted")
        return
    if not have_gh():
        print("the GitHub CLI is not installed or not signed in (gh auth login): branches are pushed with git, open the pull requests from the links printed")
    if args.results:
        post_results(runs, results)
    if args.code:
        for (name, ws), ds in drivers.items():
            post_code(name, pathlib.Path(ws), [json.loads((d / "result.json").read_text()) for d in ds])
    for d, _ in runs:
        (d / ".submitted").write_text(dt_now() + "\n")


def have_gh():
    """The GitHub CLI, installed and signed in; otherwise branches are pushed with git and the pull
    requests opened from the links printed."""
    if not shutil.which("gh"):
        return False
    try:
        return subprocess.run(["gh", "auth", "status"], capture_output=True, timeout=15).returncode == 0
    except subprocess.TimeoutExpired:
        return False


def dt_now():
    import datetime
    return datetime.datetime.now().isoformat(timespec="seconds")


def slug(name):
    return "".join(c if c.isalnum() else "_" for c in name.strip().lower()).strip("_")


def git_in(repo, *a, check=True, capture=False):
    return subprocess.run(["git", "-C", str(repo), *a], check=check, capture_output=capture, text=True)


def post_results(runs, results):
    """The scoreboard: result files on one branch, one pull request to feb-racing."""
    paths = [results.save(r).relative_to(ROOT) for _, r in runs]
    branch = f"result/{runs[-1][1]['id']}"
    git_in(ROOT, "checkout", "-B", branch)
    git_in(ROOT, "add", *[str(p) for p in paths])
    summary = ", ".join(f"{r['track']} {r['total_s']} s" for _, r in runs)
    git_in(ROOT, "commit", "-m", f"Practice results: {runs[0][1]['team']}: {summary}")
    if git_in(ROOT, "push", "-u", "origin", branch, check=False).returncode != 0:
        if not have_gh():
            fail(f"could not push {branch} to origin and the GitHub CLI is not here to fork; install gh or ask for access")
        subprocess.run(["gh", "repo", "fork", "--remote", "--remote-name", "fork"], cwd=ROOT, check=True)
        git_in(ROOT, "push", "-u", "fork", branch)
    git_in(ROOT, "checkout", "-")
    if have_gh():
        subprocess.run(["gh", "pr", "create", "--fill", "--head", branch], cwd=ROOT, check=True)
        print(f"scoreboard: pull request opened with {len(runs)} result(s); it merges automatically once the checks pass")
    else:
        print(f"scoreboard: {len(runs)} result(s) pushed on {branch}. Open the pull request: https://github.com/{RESULTS_REPO}/compare/{branch}?expand=1")


def post_code(name, ws, run_results):
    """The code: the driver's packages copied into the team repo under drivers/<you>/, one commit
    on your branch, one pull request to its main (updated if one is open). Clones the repo beside
    this one the first time; pushes to your fork when you cannot push to the repo."""
    manifest, _ = read_manifest(ws, name)
    packages = manifest.get("packages") or [name]
    me = slug(team_name())
    if not TEAM_STACK.is_dir():
        clone = ["gh", "repo", "clone", STACK_REPO, str(TEAM_STACK)] if have_gh() else \
                ["git", "clone", f"git@github.com:{STACK_REPO}.git", str(TEAM_STACK)]
        subprocess.run(clone, check=True)
    shared = [p for p in packages if (TEAM_STACK / "shared" / p).is_dir()]
    if shared:
        fail(f"{', '.join(shared)} already live in {STACK_REPO}/shared (one copy for everyone); list only your own packages in {name}'s driver.yaml")
    remotes = git_in(TEAM_STACK, "remote", capture=True).stdout.split()
    remote = "fork" if "fork" in remotes else "origin"      # your fork once you have needed one
    git_in(TEAM_STACK, "fetch", "-q", remote)
    git_in(TEAM_STACK, "fetch", "-q", "origin")
    have_branch = git_in(TEAM_STACK, "rev-parse", "-q", "--verify", f"{remote}/{me}", check=False, capture=True).returncode == 0
    git_in(TEAM_STACK, "checkout", "-q", "-B", me, f"{remote}/{me}" if have_branch else "origin/main")   # continue your branch, else start from main
    dest = TEAM_STACK / "drivers" / me
    dest.mkdir(parents=True, exist_ok=True)
    for pkg in packages:
        src = next((p.parent for p in ws.rglob("package.xml") if p.parent.name == pkg and "/build/" not in str(p) and "/install/" not in str(p)), None)
        if src is None:
            fail(f"driver {name} lists package '{pkg}' but it is not in {ws}")
        shutil.rmtree(dest / pkg, ignore_errors=True)
        shutil.copytree(src, dest / pkg, ignore=shutil.ignore_patterns("__pycache__", "*.pyc", "build", "install", "log", ".git"))
    git_in(TEAM_STACK, "add", "-A", f"drivers/{me}")
    if git_in(TEAM_STACK, "diff", "--cached", "--quiet", check=False).returncode == 0:
        print(f"code: {name} unchanged since the last push, nothing to do")
        return
    summary = ", ".join(f"{r['track']} {r['total_s']} s" for r in run_results)
    git_in(TEAM_STACK, "commit", "-q", "-m", f"{name}: {summary}\n\nruns: {', '.join(r['id'] for r in run_results)}")
    if git_in(TEAM_STACK, "push", "-q", "-u", remote, me, check=False).returncode != 0:
        if remote == "fork" or not have_gh():
            fail(f"could not push {me} to {remote} of {STACK_REPO}; see the git message above (no GitHub CLI here to fork)")
        subprocess.run(["gh", "repo", "fork", "--remote", "--remote-name", "fork"], cwd=TEAM_STACK, check=True)
        git_in(TEAM_STACK, "push", "-q", "-u", "fork", me)
        remote = "fork"
    git_in(TEAM_STACK, "checkout", "-q", "-")
    if not have_gh():
        print(f"code: {name} pushed on {me}. Open the pull request: https://github.com/{STACK_REPO}/compare/main...{me}?expand=1")
        return
    head = me if remote == "origin" else f"{gh_login()}:{me}"
    open_prs = subprocess.run(["gh", "pr", "list", "--repo", STACK_REPO, "--head", head, "--state", "open", "--json", "number"],
                              capture_output=True, text=True).stdout.strip()
    if open_prs and open_prs != "[]":
        print(f"code: pushed to {remote}/{me}; the open pull request to {STACK_REPO} is updated")
    else:
        subprocess.run(["gh", "pr", "create", "--repo", STACK_REPO, "--base", "main", "--head", head,
                        "--title", f"{name} ({manifest.get('kind', 'any')}): {summary}",
                        "--body", f"Driver `{name}` by {team_name()}.\n\nPractice runs: {', '.join(r['id'] for r in run_results)}\n\nPackages: {', '.join(packages)}"], check=True)
        print(f"code: pull request opened to {STACK_REPO} from {head}")


def gh_login():
    return subprocess.run(["gh", "api", "user", "--jq", ".login"], capture_output=True, text=True).stdout.strip()


def main():
    ap = argparse.ArgumentParser(prog="feb", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="command", required=True)
    up = sub.add_parser("up", aliases=["run"], help="house nodes in the box + simulator + Foxglove")
    up.add_argument("--track", default="loop", help="track folder name in ./tracks, or a path")
    up.add_argument("--mode", choices=["manual", "autonomous"], help="default: autonomous with --stack, manual without")
    up.add_argument("--stack", default="", help='command that drives, e.g. "ros2 launch feb_driver drive.launch.py"')
    up.add_argument("--driver", help="a driver package by name: its driver.yaml says how to launch it (see --mode-name)")
    up.add_argument("--mode-name", dest="mode_name", help="which of the driver's modes (default: its default_mode)")
    up.add_argument("--ws", help="workspace folder to build and source (default: feb-racing/stack)")
    up.add_argument("--headless", action="store_true", help="no window (organiser harness)")
    up.add_argument("--no-sim", action="store_true", help="house nodes only; you start the simulator app yourself")
    up.add_argument("--car", action="store_true", help="on the Jetson: the car's drivers instead of the simulator")
    up.add_argument("--deadman", action="store_true", help="the car's rules in the simulator: nothing drives unless a dead-man is held; this terminal is the gamepad (SPACE autonomous, M manual)")
    up.add_argument("--max-speed", type=float, help="the supervisor's speed cap, m/s (default 1.0 on the car)")
    up.add_argument("--lidar-hz", type=float, default=0, help="lidar scan rate override (default: the car's 40 Hz)")
    up.add_argument("--noise", default="", help='sensor noise, "1" for defaults or e.g. "range_sigma:=0.03 beam_dropout:=0.05 latency:=0.05"')
    up.add_argument("--cars", type=int, default=1, help="number of cars (head-to-head practice)")
    up.add_argument("--opponent", choices=list(OPPONENT_SPEED) + ["map"], help="house racer in car 2: slow | normal | fast (lidar driver) or map")
    up.add_argument("--camera", help="starting camera: \"God's Eye\", Trackcam, \"Driver's Eye\", ...")
    up.add_argument("--no-foxglove", action="store_true", help="do not open Foxglove")
    up.add_argument("--look", choices=["visual", "simple"], help="dressed scene or the bare one (default: last choice in the app, else visual)")
    up.add_argument("--fps", type=int, help="render-rate cap (default 60, 0 = uncapped); keeps simulated time at real time")
    up.add_argument("--camera-hz", type=float, help="bridge camera readback rate (default 10, 0 = every message)")
    up.set_defaults(func=cmd_up)
    practice = sub.add_parser("practice", help="scored attempts under competition rules: the driver's practice set, or one --track")
    practice.add_argument("--track", help="one track (default: every qualifying track of the driver's kind; 'all' for all of them)")
    practice.add_argument("--stack", default="", help='e.g. "ros2 launch feb_driver drive.launch.py"')
    practice.add_argument("--driver", help="a driver package by name (its driver.yaml)")
    practice.add_argument("--mode-name", dest="mode_name", help="which of its modes")
    practice.add_argument("--ws", help="workspace folder with your packages (default: feb-racing/stack)")
    practice.add_argument("--laps", type=int, default=10)
    practice.add_argument("--headless", action="store_true")
    practice.set_defaults(func=cmd_practice)
    submit = sub.add_parser("submit", help="post the finished practice runs not yet posted, as one pull request")
    submit.add_argument("--run", help="a single runs/<id> folder instead")
    submit.add_argument("--all", action="store_true", help="also post runs with collisions, dnf and dsq")
    submit.add_argument("--dry-run", action="store_true", help="list what would be posted")
    submit.add_argument("--no-code", dest="code", action="store_false", help="results only, do not push the driver's code")
    submit.add_argument("--no-results", dest="results", action="store_false", help="code only, do not post the results")
    submit.set_defaults(func=cmd_submit)
    setup = sub.add_parser("setup", help="install prerequisites, make the box, optionally set your team name")
    setup.add_argument("--team", "--name", dest="team", help="how your results are listed: your name (or a team name) as in submissions.yaml")
    setup.set_defaults(func=cmd_setup)
    sub.add_parser("update", help="git pull, newer images, newer simulator app").set_defaults(func=cmd_update)
    shell = sub.add_parser("shell", aliases=["ros"], help="a terminal in the box (ROS sourced)")
    shell.add_argument("--gui", action="store_true", help="also open the box's desktop in the browser (rviz2, rqt, turtlesim)")
    shell.add_argument("--apps", help='windows to open on the desktop: rviz, rqt, turtlesim, or any command; e.g. "turtlesim rqt"')
    shell.add_argument("-c", "--command", help="run this in the box instead of giving a shell")
    shell.set_defaults(func=cmd_shell)
    code = sub.add_parser("code", help="VS Code attached to the box")
    code.add_argument("--cursor", action="store_true", help="Cursor instead of VS Code")
    code.set_defaults(func=cmd_code)
    sub.add_parser("stop", help="end feb up; the box keeps running").set_defaults(func=cmd_stop)
    sub.add_parser("reset", help="remove the box; the next command makes a fresh one").set_defaults(func=cmd_reset)
    logs = sub.add_parser("logs", help="what feb up printed (the build, the house nodes, your stack); -f follows")
    logs.add_argument("-f", "--follow", action="store_true")
    logs.add_argument("-n", "--tail", default="200", help="lines to show (default 200, 'all')")
    logs.set_defaults(func=cmd_logs)
    args = ap.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
