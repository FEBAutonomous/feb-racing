<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>feb_cone_cnn_racer</name>
  <version>0.1.0</version>
  <description>The FEB cone racer with a trained cone detector for the colours (launches feb_cone_racer with detector:=cnn).</description>
  <maintainer email="feb@berkeley.edu">FEB autonomous team</maintainer>
  <license>MIT</license>
  <exec_depend>feb_cone_racer</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
