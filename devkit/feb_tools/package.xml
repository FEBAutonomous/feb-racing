<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>feb_tools</name>
  <version>0.1.0</version>
  <description>FEB devkit extras: the simulator adapter (the car's topic contract), the house layer launch files, sensor noise, the house driver</description>
  <maintainer email="pranavbhatttheonlyone@gmail.com">Formula Electric at Berkeley</maintainer>
  <license>BSD-2-Clause</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>ackermann_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>feb_supervisor</exec_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
